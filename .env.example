BASE_URL=https://authorized-partner.vercel.app

# Full signup requires both explicit approval flags and supported OTP settings.
RUN_FULL_SIGNUP=0
REGISTRATION_APPROVED=0

# Use only an approved private inbox that receives plus aliases. Public YOPmail
# inboxes, example domains, and placeholder mailbox names are rejected before navigation.
TEST_EMAIL=
OTP_PROVIDER=disabled
OTP_TEST_INBOX_APPROVED=0
OTP_TEST_EMAIL_SUPPORTS_PLUS=0
# Fictional test identity; override only with approved dummy values.
TEST_FIRST_NAME=Jordan
TEST_LAST_NAME=Sample
# Set these only after confirming an allowed test-number prefix and national
# number length. The signup form's accepted phone format is not verified here.
TEST_PHONE_PREFIX=
TEST_PHONE_NATIONAL_LENGTH=
TEST_PASSWORD=
# IMAP settings for the approved private inbox. Never commit credentials.
OTP_IMAP_HOST=
OTP_IMAP_PORT=993
OTP_IMAP_USER=
OTP_IMAP_PASSWORD=
OTP_IMAP_FOLDER=INBOX
OTP_SENDER_FILTER=
OTP_WAIT_TIMEOUT_MS=180000
OTP_POLL_INTERVAL_MS=2500

# OTP controls remain unverified; configure exact accessible names only after review.
OTP_INPUT_LABEL=
OTP_VERIFY_BUTTON_NAME=Verify Code

# Candidate accessible labels/button names from the supplied signup flow.
# These are not verified against the screen or accessibility tree. Confirm
# labels, control types, and button names before enabling the full signup.
AGENCY_NAME_LABEL=Agency Name
AGENCY_NAME=Northstar Pathways Education
AGENCY_ROLE_LABEL=Role in Agency
AGENCY_ROLE=
AGENCY_EMAIL_LABEL=Email Address
AGENCY_EMAIL=
AGENCY_WEBSITE_LABEL=Website
AGENCY_WEBSITE=https://example.com
AGENCY_ADDRESS_LABEL=Address
AGENCY_ADDRESS=123 Example Avenue, Sample City
AGENCY_REGION_LABEL=Region of Operation
AGENCY_REGION=
AGENCY_NEXT_BUTTON_NAME=Next

# Candidate labels from the supplied signup flow; option values and whether
# controls are single- or multi-select remain unknown and need verification.
YEARS_OF_EXPERIENCE_LABEL=Years of Experience
YEARS_OF_EXPERIENCE=
STUDENTS_RECRUITED_LABEL=Number of Students Recruited Annually
STUDENTS_RECRUITED=
FOCUS_AREA_LABEL=Focus Area
FOCUS_AREA=
SUCCESS_METRICS_LABEL=Success Metrics
SUCCESS_METRICS=
SERVICES_PROVIDED_LABEL=Services Provided
SERVICES_PROVIDED=
PROFESSIONAL_NEXT_BUTTON_NAME=Next

# Candidate labels/button names from the supplied signup flow; verify them
# against the screen. The required document(s), upload control, and success
# profile URL/heading were not specified.
BUSINESS_REGISTRATION_NUMBER_LABEL=Business Registration Number
# BUSINESS_REGISTRATION_NUMBER is retained for compatibility; the helper
# generates a unique fictional QA-TEST number for each data set.
BUSINESS_REGISTRATION_NUMBER=
PREFERRED_COUNTRIES_LABEL=Preferred Countries
PREFERRED_COUNTRY=
PREFERRED_INSTITUTION_TYPES_LABEL=Preferred Institution Types
PREFERRED_INSTITUTION_TYPE=
CERTIFICATION_DETAILS_LABEL=Certification Details
CERTIFICATION_DETAILS=
DOCUMENT_INPUT_LABEL=
# Supply only an approved dummy document; no real records.
TEST_DOCUMENT_PATH=
TEST_DOCUMENT_APPROVED=0
SUBMIT_BUTTON_NAME=Submit

# Exact expected profile URL and heading must be supplied before enabling signup.
PROFILE_SUCCESS_URL=
PROFILE_SUCCESS_HEADING=
